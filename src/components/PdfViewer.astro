---
import Divider from "./Divider.astro";

const { title, pdfUrl, summary, theme = "white", divider, nextTheme = "white" } = Astro.props;
const hasDivider = divider?.style && divider.style !== "none";
---

<section class={`cur-band cur-band--${theme} ${hasDivider ? "cur-band--has-divider" : ""}`}>
  <div class="cur-container">
    {summary && <p>{summary}</p>}
    <div class="cur-pdf">
      <div class="cur-pdf__bar">
        <strong>{title}</strong>
      </div>
      <iframe class="cur-pdf__frame" src={pdfUrl} title={title} loading="lazy"></iframe>
    </div>
  </div>
  {hasDivider && (
    <Divider style={divider.style} stroke={divider.stroke} nextTheme={nextTheme} />
  )}
</section>

<style>
  .cur-pdf {
    border: 1px solid var(--band-border, var(--cur-grey-1));
    border-radius: var(--cur-radius);
    overflow: hidden;
    background: var(--cur-white);
  }

  .cur-pdf__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1rem;
    background: var(--cur-green);
    color: var(--cur-white);
  }

  .cur-pdf__frame {
    width: 100%;
    height: 75vh;
    min-height: 560px;
    border: 0;
    display: block;
  }
</style>