---
const { title, pdfUrl, summary } = Astro.props;
---

<section class="cur-band cur-band--white">
  <div class="cur-container">
    {summary && <p>{summary}</p>}
    <div class="cur-pdf">
      <div class="cur-pdf__bar">
        <strong>{title}</strong>
        <a class="cur-pdf__download" href={pdfUrl} target="_blank" rel="noopener">
          Open / Download PDF ↗
        </a>
      </div>
      <iframe class="cur-pdf__frame" src={pdfUrl} title={title} loading="lazy"></iframe>
    </div>
  </div>
</section>

<style>
  .cur-pdf {
    border: 1px solid var(--cur-grey-1);
    border-radius: var(--cur-radius);
    overflow: hidden;
    background: var(--cur-white);
  }

  .cur-pdf__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1rem;
    background: var(--cur-green);
    color: var(--cur-white);
  }

  .cur-pdf__download {
    color: var(--cur-gold);
    font-weight: 500;
    text-decoration: none;
  }

  .cur-pdf__frame {
    width: 100%;
    height: 75vh;
    min-height: 560px;
    border: 0;
    display: block;
  }
</style>