---
import ContentBand from "./ContentBand.astro";
import SubteamAccordion from "./SubteamAccordion.astro";
import PeopleGrid from "./PeopleGrid.astro";
import PdfViewer from "./PdfViewer.astro";

const { sections = [] } = Astro.props;
---

{sections.map((section) => {
  const kind = section.type || "splitBand";
  if (kind === "splitBand") return <ContentBand {...section} />;
  if (kind === "accordion") return <SubteamAccordion {...section} />;
  if (kind === "peopleGrid") return <PeopleGrid {...section} />;
  if (kind === "pdfEmbed") return <PdfViewer {...section} />;
})}