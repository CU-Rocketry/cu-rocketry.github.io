---
import ContentBand from "./ContentBand.astro";
import SubteamAccordion from "./SubteamAccordion.astro";
import Eboard from "./Eboard.astro";
import PdfViewer from "./PdfViewer.astro";

const { sections = [], footerTheme = "green" } = Astro.props;
---

{sections.map((section, index) => {
  const kind = section.type || "splitBand";
  const nextTheme = sections[index + 1]?.theme || footerTheme;
  const props = { ...section, nextTheme };

  if (kind === "splitBand" || kind === "textBand") return <ContentBand {...props} />;
  if (kind === "accordion") return <SubteamAccordion {...props} />;
  if (kind === "peopleGrid") return <Eboard {...props} />;
  if (kind === "pdfEmbed") return <PdfViewer {...props} />;
})}