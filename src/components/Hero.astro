---
const { title, fallbackImage } = Astro.props;
---

<section class="cur-hero">
    {fallbackImage && (
        <img class="cur-hero__media" src={fallbackImage} alt="" />
    )}

    <div class="cur-hero__scrim"></div>

    <div class="cur-hero__content">
        <h1 class="cur-hero__title">{title}</h1>
    </div>

    <svg class="cur-hero__curve" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0,0 Q720,88 1440,0 L1440,80 L0,80 Z" fill="#ffcd00"></path>
        <path d="M0,12 Q720,96 1440,12 L1440,80 L0,80 Z" fill="#ffffff"></path>
    </svg>
</section>

<style>
    .cur-hero {
        position: relative;
        min-height: 82vh;
        display: grid;
        place-items: center;
        overflow: hidden;
        background-color: var(--cur-green-dark);
        color: var(--cur-white);
        text-align: center;
    }

    .cur-hero__media {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .cur-hero__scrim {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.32);
    }

    .cur-hero__content {
        position: relative;
        z-index: 2;
        padding: 2rem 1.25rem 5rem;
    }

    .cur-hero__title {
        font-size: clamp(2.1rem, 5vw, 4rem);
        color: var(--cur-white);
        margin-bottom: 1.5rem;
        text-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
    }

    .cur-hero__pause {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        border: none;
        background: rgba(22, 26, 25, 0.65);
        color: var(--cur-white);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .cur-hero__curve {
        position: absolute;
        bottom: -1px;
        left: 0;
        width: 100%;
        height: clamp(32px, 6vw, 72px);
        z-index: 3;
        pointer-events: none;
    }
</style>
