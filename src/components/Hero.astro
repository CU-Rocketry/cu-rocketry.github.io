---
import Divider from "./Divider.astro";

const {
    title,
    subtitle,
    fallbackImage,
    divider = { style: "concave-up", stroke: "gold" },
    nextTheme = "white",
} = Astro.props;
const dividerStyle = divider?.style ?? "concave-up";
const dividerStroke = divider?.stroke ?? "gold";
const hasDivider = dividerStyle && dividerStyle !== "none";
---

<section class="cur-hero">
    {fallbackImage && (
        <img class="cur-hero__media" src={fallbackImage} alt="" />
    )}

    <div class="cur-hero__scrim"></div>

    <div class="cur-hero__content">
        <h1 class="cur-hero__title">{title}</h1>
        {subtitle && <p class="cur-hero__subtitle">{subtitle}</p>}
    </div>

    {hasDivider && (
        <Divider style={dividerStyle} stroke={dividerStroke} nextTheme={nextTheme} />
    )}
</section>

<style>
    .cur-hero {
        position: relative;
        min-height: 82vh;
        display: grid;
        place-items: center;
        overflow: hidden;
        background-color: var(--cur-green-dark);
        color: var(--cur-white);
        text-align: center;
    }

    .cur-hero__media {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .cur-hero__scrim {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.32);
    }

    .cur-hero__content {
        position: relative;
        z-index: 2;
        padding: 2rem 1.25rem 5rem;
    }

    .cur-hero__title {
        font-size: clamp(2.1rem, 5vw, 4rem);
        color: var(--cur-white);
        margin-bottom: 1.5rem;
        text-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
    }

    .cur-hero__subtitle {
        font-size: 1.1rem;
        color: var(--cur-grey-1);
        margin: -0.75rem 0 0;
        text-shadow: 0 1px 8px rgba(0, 0, 0, 0.4);
    }
</style>
