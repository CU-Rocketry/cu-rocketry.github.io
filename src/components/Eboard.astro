---
import Divider from "./Divider.astro";
const { heading = "Eboard", people = [], theme = "white", divider, nextTheme = "white" } = Astro.props;
const hasDivider = divider?.style && divider.style !== "none";
---

<section class={`cur-band cur-band--${theme} ${hasDivider ? "cur-band--has-divider" : ""}`}>
  <div class="cur-container">
    {heading && <h2>{heading}</h2>}
    <div class="cur-people-grid">
      {people.map((person) => (
        <article class="cur-person">
          {person.headshot && (
            <img class="cur-person__photo" src={person.headshot} alt={person.name} loading="lazy" />
          )}
          <h3 class="cur-person__name">{person.name} '{person.year}</h3>
          <p class="cur-person__role">
            {person.role}
          </p>
        </article>
      ))}
    </div>
  </div>
  {hasDivider && (
    <Divider style={divider.style} stroke={divider.stroke} nextTheme={nextTheme} />
  )}
</section>

<style>
  .cur-people-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 2rem;
  }

  .cur-person__photo {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    margin-bottom: 0.75rem;
  }

  .cur-person__name {
    font-size: 1.1rem;
    margin-bottom: 0.2rem;
    text-align: center;
  }

  .cur-person__role {
    font-size: 0.92rem;
    color: var(--band-muted, var(--cur-grey-30));
    margin: 0;
    text-align: center;
  }
</style>