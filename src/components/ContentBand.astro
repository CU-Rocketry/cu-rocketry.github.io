---
import { renderMarkdown } from "../lib/content.js";
import Divider from "./Divider.astro";

const { theme = "white", imageSide = "left", image, caption, heading, text, divider, nextTheme = "white" } = Astro.props;
const hasDivider = divider?.style && divider.style !== "none";
const reverseClass = imageSide === "right" ? "cur-split--reverse" : "";
const html = renderMarkdown(text);
---

<section class={`cur-band cur-band--${theme} ${hasDivider ? "cur-band--has-divider" : ""}`}>
  <div class={`cur-container ${image ? `cur-split ${reverseClass}` : ""}`}>
    {image && (
      <div class="cur-split__media">
        <figure style="margin:0;">
          <img src={image} alt={caption || heading || ""} loading="lazy" />
          {caption && <figcaption>{caption}</figcaption>}
        </figure>
      </div>
    )}
    <div class="cur-split__text">
      {heading && <h2>{heading}</h2>}
      <div set:html={html} />
    </div>
  </div>
  {hasDivider && (
    <Divider style={divider.style} stroke={divider.stroke} nextTheme={nextTheme} />
  )}
</section>

<style>
  .cur-split {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: center;
  }

  .cur-split--reverse .cur-split__media {
    order: 2;
  }

  .cur-split__media img {
    width: 100%;
    border-radius: var(--cur-radius);
  }
</style>