---
// src/pages/blog/[slug].astro
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadMarkdownCollection } from "../../lib/content.js";

export function getStaticPaths() {
  return loadMarkdownCollection("blog")
    .filter((p) => !p.data.draft)
    .map((post) => ({
      params: { slug: post.slug },
      props: { post },
    }));
}

const { post } = Astro.props;
---

<BaseLayout title={post.data.title}>
  <article class="cur-prose">
    <h1>{post.data.title}</h1>
    <p style="color:var(--cur-grey-30); font-size:0.95rem;">
      {post.data.date}{post.data.author ? ` · ${post.data.author}` : ""}
    </p>
    {post.data.coverImage && <img src={post.data.coverImage} alt={post.data.title} />}
    <div set:html={post.html} />
  </article>
</BaseLayout>