---
// src/pages/blog/index.astro
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadMarkdownCollection } from "../../lib/content.js";

const posts = loadMarkdownCollection("blog")
  .filter((p) => !p.data.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<BaseLayout title="Blog">
  <section class="cur-prose">
    <h1>Blog & Build Logs</h1>
    {posts.map((post) => (
      <article style="margin-bottom:2.5rem; padding-bottom:2rem; border-bottom:1px solid var(--cur-grey-1);">
        <h2><a href={`/blog/${post.slug}`}>{post.data.title}</a></h2>
        <p style="color:var(--cur-grey-30); font-size:0.9rem;">
          {post.data.date}{post.data.author ? ` · ${post.data.author}` : ""}
        </p>
        {post.data.excerpt && <p>{post.data.excerpt}</p>}
      </article>
    ))}
  </section>
</BaseLayout>