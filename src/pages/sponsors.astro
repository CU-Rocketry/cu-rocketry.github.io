---
import BaseLayout from "../layouts/BaseLayout.astro";
import PdfViewer from "../components/PdfViewer.astro";
import SectionRenderer from "../components/SectionRenderer.astro";
import { loadYaml, renderMarkdown } from "../lib/content.js";

const sponsors = loadYaml("sponsors.yml");
const tiers = ["Platinum", "Gold", "Green", "Partner"];
const list = sponsors.list || [];
const sections = sponsors.sections || [];
const afterBrochureTheme = sections[0]?.theme || "green";
---

<BaseLayout title="Sponsors">
  <section class="cur-band cur-band--white">
    <div class="cur-container">
      <h1>Sponsors</h1>
      <div set:html={renderMarkdown(sponsors.intro)} />
    </div>
  </section>

  {tiers.map((tier) => {
    const items = list.filter((s) => s.tier === tier);
    if (items.length === 0) return null;
    return (
      <section class="cur-band cur-band--white">
        <div class="cur-container">
          <h2>{tier} Sponsors</h2>
          <div class="cur-sponsors-grid">
            {items.map((sponsor) => (
              <article>
                {sponsor.logo && (
                  <a href={sponsor.url || "#"} target="_blank" rel="noopener">
                    <img src={sponsor.logo} alt={sponsor.name} style="max-height:90px; margin-bottom:0.75rem;" loading="lazy" />
                  </a>
                )}
                <h3>{sponsor.name}</h3>
                {sponsor.description && <p>{sponsor.description}</p>}
              </article>
            ))}
          </div>
        </div>
      </section>
    );
  })}

  {sections.length > 0 && <SectionRenderer sections={sections} footerTheme="green" />}
</BaseLayout>

<style>
  /* still Sponsors grid, max 3 cols, separate from people grid */
  .cur-sponsors-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem;
  }

  @media (max-width: 860px) {
    .cur-sponsors-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .cur-sponsors-grid {
      grid-template-columns: 1fr;
    }
  }
</style>