---
import { Font } from "astro:assets";
import "../styles/cur-tokens.css";
import "../styles/cur-components.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { loadYaml } from "../lib/content.js";

const settings = loadYaml("settings.yml");
const { title } = Astro.props;
const pageTitle = title ? `${title} | ${settings.siteTitle}` : settings.siteTitle;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/media/cur-logo/cur-logo.svg" />
    <link rel="icon" type="image/png" href="/media/cur-logo/cur-logo-512.png" sizes="any" />
    <title>{pageTitle}</title>
    <Font cssVariable="--font-heading" preload />
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-display" />
  </head>
  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>